# CardPlay — zmienne środowiskowe
# Skopiuj ten plik jako .env i uzupełnij wartości.
# Nigdy nie commituj pliku .env do repozytorium!

# ── Środowisko ───────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Porty ────────────────────────────────────────────────────────────────────
PORT=3000
CLIENT_PORT=5173
DB_PORT=5432

# ── Baza danych (PostgreSQL) ─────────────────────────────────────────────────
DB_USER=cardplay_user
DB_PASSWORD=change_me_in_production
DB_NAME=cardplay_db
DATABASE_URL=postgres://cardplay_user:change_me_in_production@localhost:5432/cardplay_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimalna długość: 64 znaki. JWT_SECRET i JWT_REFRESH_SECRET muszą być różne.
JWT_SECRET=replace_with_64_random_hex_chars_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=replace_with_another_64_random_hex_chars_bbbbbbbbbbbbbbbbbbbbbbbbbbbbb
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Seed (wymagane explicit TRUE — zabezpieczenie przed uruchomieniem na prod) ─
# Ustaw na true tylko na środowisku developerskim lub testowym.
ALLOW_TEST_SEED=false

# ── Vite (frontend) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000
