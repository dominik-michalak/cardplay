{
  "_comment": "server/package.json — konfiguracja @cardplay/server. Zależności runtime: express, socket.io, pg, bcrypt, jsonwebtoken, zod. Jest skonfigurowany bez --forceExit — timer w socket/index.ts używa unref() zamiast tego.",
  "name": "@cardplay/server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev":        "ts-node-dev --respawn --transpile-only src/server.ts",
    "build":      "tsc",
    "start":      "node dist/server.js",
    "typecheck":  "tsc --noEmit",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:seed":    "ts-node src/db/seeds/001_test_users.ts",
    "test":       "jest --runInBand"
  },
  "dependencies": {
    "@cardplay/shared": "*",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@cardplay/shared$": "<rootDir>/../shared/src/index.ts"
    }
  }
}
